rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users — 닉네임 매핑
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId;
    }

    // groups
    match /groups/{groupId} {

      // 가입/탈퇴 — members 필드만, 본인 추가/제거만
      function isMembershipChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
               && (
                    // 가입: 본인만 추가 + 정원 이내
                    (request.resource.data.members == resource.data.members.concat([request.auth.uid])
                     && request.resource.data.members.size() <= 4)
                    ||
                    // 탈퇴: 본인만 제거
                    request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
                  );
      }

      // 정보 수정 — 멤버만, name/description/imageUrl만
      function isInfoEdit() {
        return request.auth.uid in resource.data.members
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'description', 'imageUrl'])
               && request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.description is string
               && request.resource.data.imageUrl is string;
      }

      allow read: if isSignedIn();    // 링크로 가입 전에도 봐야 함
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn()
                    && (isMembershipChange() || isInfoEdit());

      // 마지막 멤버가 본인일 때만 삭제
      allow delete: if isSignedIn()
                    && resource.data.members.hasOnly([request.auth.uid]);
    }

    // records
    match /records/{recordId} {

      // reactions 맵에서 바뀐 키가 '내 uid' 하나뿐이고, 값이 허용된 종류인지
      // (삭제면 키가 사라지므로 값 검사는 건너뛴다)
      function onlyMyReactionChanged() {
        let before = resource.data.get('reactions', {});
        let after = request.resource.data.get('reactions', {});
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
               && (!(request.auth.uid in after)
                   || after[request.auth.uid] in ['muscle', 'fire', 'clap']);
      }

      // 리액션은 그 그룹 멤버만. get() 1회 = 읽기 1건 추가 과금
      function isMemberOfRecordGroup() {
        return request.auth.uid in
               get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;
      }

      allow read: if isSignedIn();    // A방식: 로그인이면 읽기

      // 생성 시 리액션을 미리 채워 넣지 못하게
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && !('reactions' in request.resource.data);

      allow update: if isSignedIn()
                    && (
                         // 작성자: 본문 수정 — 남의 리액션은 건드릴 수 없음
                         (request.auth.uid == resource.data.userId
                          && onlyMyReactionChanged())
                         ||
                         // 그룹원: reactions 필드의 내 키만
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                          && onlyMyReactionChanged()
                          && isMemberOfRecordGroup())
                       );

      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
    }
  }
}