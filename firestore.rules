rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users — 닉네임 매핑
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId;
    }

    // groups
    match /groups/{groupId} {

      // 가입/탈퇴 — members 필드만, 본인 추가/제거만
      function isMembershipChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
               && (
                    // 가입: 본인만 추가 + 정원 이내
                    (request.resource.data.members == resource.data.members.concat([request.auth.uid])
                     && request.resource.data.members.size() <= 4)
                    ||
                    // 탈퇴: 본인만 제거
                    request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
                  );
      }

      // 정보 수정 — 멤버만, name/description/imageUrl만
      function isInfoEdit() {
        return request.auth.uid in resource.data.members
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'description', 'imageUrl'])
               && request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.description is string
               && request.resource.data.imageUrl is string;
      }

      allow read: if isSignedIn();    // 링크로 가입 전에도 봐야 함
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn()
                    && (isMembershipChange() || isInfoEdit());

      // 마지막 멤버가 본인일 때만 삭제
      allow delete: if isSignedIn()
                    && resource.data.members.hasOnly([request.auth.uid]);
    }

    // records
    match /records/{recordId} {
      allow read: if isSignedIn();    // A방식: 로그인이면 읽기
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;
    }
  }
}