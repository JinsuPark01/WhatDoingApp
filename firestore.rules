rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users — 닉네임·프로필 사진 매핑 (로그인한 누구나 읽음 → 공개해도 되는 필드만)
    match /users/{userId} {

      function isSelf() {
        return isSignedIn() && request.auth.uid == userId;
      }

      // 규칙은 문서 단위로만 막을 수 있다 → 숨길 값은 이 문서에 아예 못 들어오게
      function hasNoPrivateFields() {
        return !request.resource.data.keys().hasAny(['fcmToken', 'email']);
      }

      allow read: if isSignedIn();
      allow create, update: if isSelf() && hasNoPrivateFields();
      // 삭제 요청엔 request.resource가 없어서 필드 검사를 같이 묶으면 항상 거부된다 → 분리
      allow delete: if isSelf();

      // 본인만 읽고 쓰는 값 (FCM 토큰)
      match /private/{docId} {
        allow read, write: if isSelf();
      }
    }

    // groups
    match /groups/{groupId} {

      // 가입/탈퇴 — members 필드만, 본인 추가/제거만
      function isMembershipChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
               && (
                    // 가입: 본인만 추가 + 정원 이내
                    (request.resource.data.members == resource.data.members.concat([request.auth.uid])
                     && request.resource.data.members.size() <= 4)
                    ||
                    // 탈퇴: 본인만 제거
                    request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
                  );
      }

      // 정보 수정 — 멤버만, name/description/imageUrl만
      function isInfoEdit() {
        return request.auth.uid in resource.data.members
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['name', 'description', 'imageUrl'])
               && request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.description is string
               && request.resource.data.imageUrl is string;
      }

      allow read: if isSignedIn();    // 링크로 가입 전에도 봐야 함
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn()
                    && (isMembershipChange() || isInfoEdit());

      // 마지막 멤버가 본인일 때만 삭제
      allow delete: if isSignedIn()
                    && resource.data.members.hasOnly([request.auth.uid]);
    }

    // records
    match /records/{recordId} {

      function isRecordOwner() {
        return request.auth.uid == resource.data.userId;
      }

      // reactions 맵에서 바뀐 키가 '내 uid' 하나뿐이고, 값이 허용된 종류인지
      // (삭제면 키가 사라지므로 값 검사는 건너뛴다)
      function onlyMyReactionChanged() {
        let before = resource.data.get('reactions', {});
        let after = request.resource.data.get('reactions', {});
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
               && (!(request.auth.uid in after)
                   || after[request.auth.uid] in ['muscle', 'fire', 'clap']);
      }

      // 기록이 속한 그룹의 멤버인지. get() 1회 = 읽기 1건 추가 과금
      function isMemberOfRecordGroup() {
        return request.auth.uid in
               get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;
      }

      // 본인 기록이거나 그 그룹 멤버만 읽기.
      // 본인 검사를 먼저 — userId == 내 uid 쿼리(닉네임 일괄 변경 등)는 여기서 통과해 get()을 거치지 않는다.
      // groupId 쿼리는 멤버 검사로 넘어가 쿼리당 읽기 +1.
      // 그룹이 삭제돼 get()이 실패해도 본인 기록은 앞에서 이미 통과한다 (탈퇴 후 정리 흐름).
      allow read: if isSignedIn()
                  && (isRecordOwner() || isMemberOfRecordGroup());

      // 생성 시 리액션을 미리 채워 넣지 못하게
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && !('reactions' in request.resource.data);

      allow update: if isSignedIn()
                    && (
                         // 작성자: 본문 수정 — 남의 리액션은 건드릴 수 없음
                         (isRecordOwner()
                          && onlyMyReactionChanged())
                         ||
                         // 그룹원: reactions 필드의 내 키만
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                          && onlyMyReactionChanged()
                          && isMemberOfRecordGroup())
                       );

      allow delete: if isSignedIn()
                    && isRecordOwner();
    }
  }
}